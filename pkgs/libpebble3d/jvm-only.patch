+// Nixpkgs' generic dependency task cannot see configurations that KSP and
+// Kotlin Multiplatform create lazily. Resolve every JVM/KSP classpath in one
+// explicit task while generating the offline dependency lock.
+tasks.register("nixResolveJvmDependencies") {
+    // KSP creates its compiler classpath as a detached configuration only
+    // after Gradle asks for kspKotlinJvm's task dependencies. Force that
+    // lazy configuration into existence while gradle.fetchDeps is recording.
+    dependsOn("kspKotlinJvm")
+    doLast {
+        configurations
+            .filter { it.isCanBeResolved && (it.name.contains("jvm", ignoreCase = true) || it.name.contains("ksp", ignoreCase = true)) }
+            .forEach {
+                logger.lifecycle("Resolving ${it.name}")
+                it.resolve()
+            }
     }
 }
 
